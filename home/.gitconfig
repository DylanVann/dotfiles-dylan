# Name, email, signing key and commit.gpgsign live in ~/.gitconfig.local, which
# isn't checked in, so this file works on a machine with no key set up
[include]
	path = ~/.gitconfig.local
[core]
	# global ignores live in ~/.config/git/ignore, git's default location
	editor = vim
	ignorecase = false
[init]
	defaultBranch = main
[push]
	default = current
	autoSetupRemote = true
[pull]
	ff = only
[rebase]
	updateRefs = false
[rerere]
	enabled = true
[alias]
	rmbranch = "!f(){ git branch -D ${1} && git push origin --delete ${1}; };f"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[lfs]
	contenttype = 0
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
