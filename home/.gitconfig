# Name, email and signing key live in ~/.gitconfig.local, which isn't checked in
[include]
	path = ~/.gitconfig.local
[core]
	excludesfile = ~/.gitignore_global
	editor = vim
	ignorecase = false
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[push]
	default = current
	autoSetupRemote = true
[pull]
	ff = only
[rebase]
	updateRefs = false
[rerere]
	enabled = true
[alias]
	rmbranch = "!f(){ git branch -D ${1} && git push origin --delete ${1}; };f"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[lfs]
	contenttype = 0
