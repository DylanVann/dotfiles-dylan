# https://ghostty.org/docs/config

working-directory = ~/Developer

# Custom themes in ./themes matching Xcode 27's light and dark defaults (see README).
# Ghostty switches live with the system appearance.
theme = light:Xcode System Light,dark:Xcode System Dark

keybind = unconsumed:ctrl+l=goto_split:right
keybind = unconsumed:ctrl+h=goto_split:left
keybind = unconsumed:ctrl+k=goto_split:top
keybind = unconsumed:ctrl+j=goto_split:bottom

unfocused-split-opacity = 0.9
window-padding-x = 8
window-padding-y = 0

font-family = SF Mono
font-size = 13

scrollback-limit = 1073741824

auto-update-channel = stable

clipboard-paste-protection = "false"
